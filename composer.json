{
  "name": "denosyscore/database",
  "description": "Database ORM, query builder, migrations, and seeding",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "doctrine/inflector": "^2.1",
    "illuminate/collections": "^12.0 || ^13.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Database\\": "src/Database/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit",
    "analyse:types": "phpstan analyse --no-progress --configuration=phpstan-types.neon"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.15.x-dev"
    }
  },
  "suggest": {
    "fakerphp/faker": "Required by model factories (Denosys\\Database\\Factory)"
  }
}
